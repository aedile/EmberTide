# sdkconfig.defaults — FiestaQuest ESP-IDF SDK configuration defaults
#
# Target: ESP32-S3-PICO-1-N8R8
#   - Xtensa LX7 dual-core @ 240 MHz
#   - 8 MiB SPI Flash (QD)
#   - 8 MiB Octal PSRAM (SPIRAM)
#
# These settings are applied before sdkconfig. Any key not listed here
# uses the ESP-IDF component default.

# ---------------------------------------------------------------------------
# Partition table
# ---------------------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ---------------------------------------------------------------------------
# Flash size
# ---------------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# ---------------------------------------------------------------------------
# SPIRAM (Octal PSRAM on ESP32-S3-PICO-1-N8R8)
# ---------------------------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y

# SPIRAM: match factory firmware settings.
# USE_MALLOC routes default malloc to PSRAM; ALWAYSINTERNAL keeps small
# allocations (<16KB, including I2S/GDMA handles) in internal SRAM.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ---------------------------------------------------------------------------
# GDMA safety — CRITICAL for I2S audio on ESP32-S3 with PSRAM.
# Without these, GDMA interrupt descriptors can land in cache-mapped
# PSRAM and cause LoadStoreAlignment crashes.
# (Discovered missing during audio lab session 2026-04-05)
# ---------------------------------------------------------------------------
# GDMA IRAM flags DISABLED — IDF 5.3 bug #15533: enabling GDMA_ISR_IRAM_SAFE
# without I2S_ISR_IRAM_SAFE causes LoadStoreAlignment crash in intr_alloc.
# Fixed in IDF 5.5 (commit 87aa9ec). Safe to re-enable after upgrade.
# CONFIG_GDMA_ISR_IRAM_SAFE is not set
# CONFIG_GDMA_CTRL_FUNC_IN_IRAM is not set

# ---------------------------------------------------------------------------
# Target
# ---------------------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"

# ---------------------------------------------------------------------------
# FreeRTOS
# ---------------------------------------------------------------------------
CONFIG_FREERTOS_HZ=1000

# ---------------------------------------------------------------------------
# Logging (default level: INFO; errors always logged)
# ---------------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BSP_AUDIO=y

# ES8311 codec support (used by codec_board for audio output)
CONFIG_CODEC_ES8311_SUPPORT=y
